#! /bin/bash

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OUT_DIR=${BIN_DIR}/../.build
UMD_BUILD=${OUT_DIR}/unigraph-explorer-intern.js
HASTE_BUILD=${OUT_DIR}/unigraph-explorer-umd-haste-build.js

$BIN_DIR/build_wasm

./node_modules/.bin/rolldown -c ./rolldown.config.ts

cp $UMD_BUILD $HASTE_BUILD

# cx() is a special instruction in haste. Unfortunately some dependencies
# use it as an alias for clsx. we should be able to safely rename it to use
# clsx directly.
ruby -i -pe 'gsub(/\b(cx)\(/, "clsx(")' "$HASTE_BUILD"

# jsx-runtime at meta comes directly from react.
sed -r -i '' -e 's|react/jsx-runtime|react|g' $HASTE_BUILD

# using `import.meta.url` will result in a syntax error. The code branch that is
# using it should not be executed and wrapping it in quotes should fix it.
sed -r -i '' -e 's|import\.meta\.url| "import.meta.url not supported"|g' $HASTE_BUILD
